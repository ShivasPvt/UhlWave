# Copy this file to .env and fill it in. Never commit .env (it's in .gitignore).

# Leave unset to use a local SQLite file (chat.db). For deployment, paste your
# Supabase or Neon Postgres connection string here.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-a-long-random-string

# "true" when served over HTTPS (on Render). "false" for localhost.
COOKIE_SECURE=false

# AI assistant (optional). Any OpenAI-compatible API works.
# Groq (free tier): https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
# Gemini instead:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.0-flash
