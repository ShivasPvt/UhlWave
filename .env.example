# Copy this file to .env and fill it in. Never commit .env (it's in .gitignore).

# Leave unset to use a local SQLite file (chat.db). For deployment, paste your
# Supabase or Neon Postgres connection string here.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-me-with-a-long-random-string

# Encrypts messages, files and photos inside the database (AES-256-GCM).
# Make one with:  python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# KEEP A COPY SOMEWHERE SAFE: without it, stored messages can't be read. Use the same key when you deploy.
# Left empty, the app makes one in a file called .message_key (never committed).
MESSAGE_KEY=

# "true" when served over HTTPS (on Render). "false" for localhost.
COOKIE_SECURE=false

# AI assistant (optional). Any OpenAI-compatible API works.
# Groq (free tier): https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# What @ai uses for photos and voice notes (Groq model names; see console.groq.com/docs/models):
# LLM_VISION_MODEL=qwen/qwen3.8-27b
# LLM_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Limits on what @ai reads: newest photos per reply, max photo size, characters per file, PDF pages.
# AI_MAX_IMAGES=2
# AI_MAX_IMAGE_BYTES=4194304
# AI_MAX_FILE_CHARS=12000
# AI_MAX_PDF_PAGES=20
# Weather and place lookups for @ai (free, no key needed). "Here" defaults to the campus:
# AI_TOOLS=true
# AI_DEFAULT_PLACE=IIT Mandi, Kamand, Himachal Pradesh
# AI_DEFAULT_LATITUDE=31.776
# AI_DEFAULT_LONGITUDE=76.986
# Gemini instead:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=<a current model from https://ai.google.dev/gemini-api/docs/models>

# Google sign-in ("Continue with Google"). Optional; leave empty to turn it off.
# Create an OAuth client ID (type: Web application) at
#   https://console.cloud.google.com/apis/credentials
# and add http://localhost:8000 (and your Render URL) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Only allow one email domain, e.g. students.iitmandi.ac.in. Empty = any Google account.
GOOGLE_ALLOWED_DOMAIN=

# ---- GIFs and stickers ----
# Free key: https://developers.giphy.com/dashboard/ -> Create an API key -> API.
# Without it, built-in stickers still work and GIF search says it isn't set up.
GIPHY_API_KEY=

# ---- Pictures: "/imagine a red panda" or "@ai draw ..." ----
# Easiest: a free Hugging Face token (https://huggingface.co/settings/tokens, "Read" is enough).
HF_TOKEN=
# Or Pollinations (https://enter.pollinations.ai). Without either key it tries
# Pollinations' old keyless address, which may be slow or switched off.
POLLINATIONS_API_KEY=
# IMAGE_PROVIDER=auto        # auto, huggingface or pollinations
# IMAGES_PER_HOUR=10         # per person, so nobody uses up the free credits

# ---- Voice and video calls ----
# Works on most home and phone networks as is. Strict networks (some college
# Wi-Fi, mobile data) also need a TURN relay; free one: https://www.metered.ca/stun-turn
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443
# TURN_USERNAME=
# TURN_CREDENTIAL=
